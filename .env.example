# Copia este archivo como .env y rellena tus propios valores.

# Base de datos Postgres (Neon)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# Emails con permisos de administrador (miembros, orden de turnos, bote,
# corregir sorteos), separados por comas si hay más de uno.
ADMIN_EMAILS="tuemail@gmail.com"

# Vercel Blob (fotos de los boletos). En Vercel se rellena solo al crear el
# store Blob y conectarlo al proyecto; en local, copia el valor desde
# Vercel → Storage → tu Blob → .env.local
BLOB_READ_WRITE_TOKEN=""

# Secreto que Vercel Schedules manda al llamar a la tarea diaria (avisos y
# resultados), como "Authorization: Bearer <CRON_SECRET>".
# Cualquier texto largo aleatorio.
CRON_SECRET="otro-texto-largo-aleatorio"

# Envío de avisos por email (Gmail SMTP), igual que en Tarados Malibú: puedes
# usar los mismos valores. Opcional: si se dejan vacíos, la app funciona
# igual pero no manda avisos. Fuera de producción solo llegan a ADMIN_EMAILS.
# 1. Verificación en dos pasos activada en la cuenta de Gmail.
# 2. https://myaccount.google.com/apppasswords → genera una para "Correo".
GMAIL_USER="tuemail@gmail.com"
GMAIL_APP_PASSWORD="contraseña de aplicación de 16 caracteres"
